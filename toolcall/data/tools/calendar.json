{
  "domain": "calendar",
  "tools": [
    {
      "name": "create_event",
      "terse": "Create an event.",
      "rich": "Create a single, one-off event on one date. For an event that repeats, use the recurring-event tool.",
      "params": [
        {
          "name": "title",
          "type": "string",
          "required": true,
          "terse": "Title.",
          "rich": "Event title as the attendees will see it."
        },
        {
          "name": "date",
          "type": "string",
          "required": true,
          "terse": "Date.",
          "rich": "The date, YYYY-MM-DD.",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "name": "start_time",
          "type": "string",
          "required": true,
          "terse": "Start.",
          "rich": "Local start time, 24-hour HH:MM.",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        {
          "name": "duration_minutes",
          "type": "integer",
          "required": true,
          "terse": "Duration.",
          "rich": "Length in minutes, 5 to 480."
        },
        {
          "name": "attendees",
          "type": "array",
          "required": false,
          "terse": "Attendees.",
          "rich": "Email addresses to invite.",
          "items": "string"
        }
      ]
    },
    {
      "name": "create_recurring_event",
      "terse": "Create a recurring event.",
      "rich": "Create an event that repeats every week on one weekday.",
      "params": [
        {
          "name": "title",
          "type": "string",
          "required": true,
          "terse": "Title.",
          "rich": "Event title as the attendees will see it."
        },
        {
          "name": "weekday",
          "type": "string",
          "required": true,
          "terse": "Weekday.",
          "rich": "Day of the week it repeats on.",
          "enum": [
            "monday",
            "tuesday",
            "wednesday",
            "thursday",
            "friday",
            "saturday",
            "sunday"
          ]
        },
        {
          "name": "start_time",
          "type": "string",
          "required": true,
          "terse": "Start.",
          "rich": "Local start time, 24-hour HH:MM.",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        {
          "name": "duration_minutes",
          "type": "integer",
          "required": true,
          "terse": "Duration.",
          "rich": "Length in minutes, 5 to 480."
        }
      ]
    },
    {
      "name": "list_events",
      "terse": "List events.",
      "rich": "Every event on one date, with ids, times and titles.",
      "params": [
        {
          "name": "date",
          "type": "string",
          "required": true,
          "terse": "Date.",
          "rich": "The date, YYYY-MM-DD.",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      ]
    },
    {
      "name": "find_free_slots",
      "terse": "Find free time.",
      "rich": "Open slots of at least the given length on one date, between 08:00 and 18:00.",
      "params": [
        {
          "name": "date",
          "type": "string",
          "required": true,
          "terse": "Date.",
          "rich": "The date, YYYY-MM-DD.",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "name": "duration_minutes",
          "type": "integer",
          "required": true,
          "terse": "Duration.",
          "rich": "Length in minutes, 5 to 480."
        }
      ]
    },
    {
      "name": "update_event",
      "terse": "Change an event.",
      "rich": "Move or rename an existing event by its id. Only the fields given change.",
      "params": [
        {
          "name": "event_id",
          "type": "string",
          "required": true,
          "terse": "Event.",
          "rich": "The id returned by the day listing or the title search."
        },
        {
          "name": "new_title",
          "type": "string",
          "required": false,
          "terse": "New title.",
          "rich": "Replacement title."
        },
        {
          "name": "new_start_time",
          "type": "string",
          "required": false,
          "terse": "New start.",
          "rich": "New local start time, HH:MM.",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        }
      ]
    },
    {
      "name": "cancel_event",
      "terse": "Cancel an event.",
      "rich": "Delete an existing event by its id and notify attendees.",
      "params": [
        {
          "name": "event_id",
          "type": "string",
          "required": true,
          "terse": "Event.",
          "rich": "The id returned by the day listing or the title search."
        }
      ]
    },
    {
      "name": "add_attendee",
      "terse": "Invite someone.",
      "rich": "Add one invitee to an existing event by its id.",
      "params": [
        {
          "name": "event_id",
          "type": "string",
          "required": true,
          "terse": "Event.",
          "rich": "The id returned by the day listing or the title search."
        },
        {
          "name": "email",
          "type": "string",
          "required": true,
          "terse": "Email.",
          "rich": "The invitee's email address."
        }
      ]
    },
    {
      "name": "set_reminder",
      "terse": "Set a reminder.",
      "rich": "Remind the owner a number of minutes before an existing event.",
      "params": [
        {
          "name": "event_id",
          "type": "string",
          "required": true,
          "terse": "Event.",
          "rich": "The id returned by the day listing or the title search."
        },
        {
          "name": "minutes_before",
          "type": "integer",
          "required": true,
          "terse": "Minutes.",
          "rich": "Minutes before the start, 1 to 1440."
        }
      ]
    },
    {
      "name": "get_event",
      "terse": "Get an event.",
      "rich": "Full details of one event by its id.",
      "params": [
        {
          "name": "event_id",
          "type": "string",
          "required": true,
          "terse": "Event.",
          "rich": "The id returned by the day listing or the title search."
        }
      ]
    },
    {
      "name": "search_events",
      "terse": "Search events.",
      "rich": "Events whose title contains the query, across all dates.",
      "params": [
        {
          "name": "query",
          "type": "string",
          "required": true,
          "terse": "Query.",
          "rich": "Text to look for in titles."
        }
      ]
    }
  ]
}
