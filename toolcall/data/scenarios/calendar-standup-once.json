{
  "id": "calendar-standup-once",
  "source": {
    "kind": "authored"
  },
  "domain": "calendar",
  "target_failure_mode": "WRONG_PARAMS",
  "tools": [
    "create_event",
    "list_events"
  ],
  "confusables": [
    "create_recurring_event",
    "update_event",
    "find_free_slots",
    "set_reminder"
  ],
  "user_message": "Put a 15-minute 'Team standup' on 2026-11-09 at quarter past two in the afternoon.",
  "expectation": {
    "acceptable_calls": [
      {
        "tool": "create_event",
        "args": {
          "title": {
            "one_of": [
              "Team standup",
              "Team Standup"
            ]
          },
          "date": "2026-11-09",
          "start_time": "14:15",
          "duration_minutes": 15
        },
        "may_include": {
          "attendees": {
            "one_of": [
              []
            ]
          }
        }
      }
    ]
  },
  "notes": "'quarter past two in the afternoon' must become 14:15; 2:15, 02:15 or 2:15 PM is a wrong value."
}
